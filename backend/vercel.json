{
  "version": 2,
  "framework": null,
  "installCommand": "npm ci --omit=dev --workspaces=false",
  "buildCommand": "",
  "functions": { "api/index.js": { "includeFiles": "certs/**" } },
  "crons": [
    { "path": "/api/v1/cron/expire", "schedule": "0 0 * * *" },
    { "path": "/api/v1/cron/cleanup", "schedule": "0 1 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
