DB_JDBC_URL=jdbc:postgresql://localhost:5432/schoolshop
DB_USERNAME=shop_runtime
DB_PASSWORD=
# Node/Vercel may use DATABASE_URL instead of DB_JDBC_URL.
# Keep TLS verification enabled. Paste CA PEM (escaped \n) or use a CA file.
DB_SSL_CA=
DB_SSL_CA_PATH=
DB_POOL_MAX=3
MIGRATIONS_ENABLED=false
MIGRATION_DB_URL=jdbc:postgresql://localhost:5432/schoolshop
MIGRATION_DB_USERNAME=shop_migration
MIGRATION_DB_PASSWORD=
MIGRATION_DB_SSL_CA=
MIGRATION_DB_SSL_CA_PATH=
# Separate random secret; Vercel sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
JWT_ISSUER_URI=https://YOUR_PROJECT.supabase.co/auth/v1
JWT_JWK_SET_URI=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
JWT_EXPECTED_AUDIENCE=authenticated
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_BACKEND_SECRET_KEY=
SELLER_REGISTRATION_CODE=
APP_SHOP_ID=00000000-0000-0000-0000-000000000001
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
# Two independent base64-encoded 32-byte keys. Generate locally; never commit values.
IDEMPOTENCY_ENCRYPTION_KEY=
GUEST_SESSION_SIGNING_KEY=
PENDING_ORDER_TTL_HOURS=24
GUEST_TOKEN_TTL_DAYS=90
PUBLIC_PRODUCT_BUCKET=product-images
PRIVATE_PAYMENT_BUCKET=payment-qr
