{
  "name": "school-shop-backend",
  "version": "1.0.0",
  "description": "School Shop Backend in Node.js",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --import ./tests/setup.js --test tests/**/*.test.js",
    "migrate": "node src/migrations/migrate.js",
    "migrate:upgrade-node": "node scripts/upgrade-node-db.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jose": "^5.9.6",
    "multer": "^2.4.0",
    "pg": "^8.13.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": "24.x"
  }
}
